# Lấy ở https://aistudio.google.com/apikey
GEMINI_API_KEY=

PORT=3001

# Domain frontend được phép gọi API (CORS), phân cách bằng dấu phẩy.
# Ví dụ: https://ten-du-an.vercel.app
ALLOWED_ORIGINS=
