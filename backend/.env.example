# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Lấy ở Supabase Settings > API Keys
SUPABASE_URL=https://zfawihhzafqvbdoevhln.supabase.co
# service_role key — toàn quyền trên database, CHỈ dùng ở backend, không đưa ra frontend
